# Copy to infra/.env (gitignored) and fill in. Never commit the real file.

# Local Postgres password. Generate one: openssl rand -hex 24
PG_PASSWORD=

# Image tags. Change API_TAG to roll back to an older build (see README).
API_TAG=dev
WEB_TAG=dev

# Where backups are written. Keep it OUTSIDE the repo / OneDrive, e.g. C:/Users/<you>/anveshan-backups
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
