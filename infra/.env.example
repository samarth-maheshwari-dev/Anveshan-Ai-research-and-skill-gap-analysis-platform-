# Copy to infra/.env (gitignored) and fill in. Never commit the real file.

# Local Postgres password. Generate one: openssl rand -hex 24
PG_PASSWORD=

# Image tags. Change API_TAG to roll back to an older build (see README).
API_TAG=dev
WEB_TAG=dev

# Optional: env file with GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET.
# Keep it OUTSIDE the repo, e.g. C:/Users/<you>/anveshan-secrets/dev-oauth.txt
OAUTH_ENV_FILE=

# Required: Tink keyset (JSON) that encrypts users' AI keys. Keep it OUTSIDE the repo and back it up
# offline — losing it makes every stored key unreadable. Create one with:
#   tinkey create-keyset --key-template AES256_GCM --out-format json --out <path>
TINK_KEYSET_FILE=

# Where backups are written. Keep it OUTSIDE the repo / OneDrive, e.g. C:/Users/<you>/anveshan-backups
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
